)}}ms","response-first-token-time-seconds_one":"{{count, number(maximumFractionDigits: 1)}}s","response-first-token-time-seconds_other":"{{count, number(maximumFractionDigits: 1)}}s","response-time-label":"Response time:","response.negative-feedback.annoying":"Annoying","response.negative-feedback.forgot-something":"Forgot something","response.negative-feedback.incorrect-answer":"Incorrect answer","response.negative-feedback.not-convincing":"Not convincing","response.negative-feedback.too-wordy":"Too wordy","response.negative-feedback.want-more-info":"Want more info","response.negative-feedback.wanted-something-else":"Wanted something else","response.positive-feedback.accurate-info":"Accurate information","response.positive-feedback.funny-response":"Funny response","response.positive-feedback.good-use-of-memory":"Good use of memory","response.positive-feedback.helpful-answer":"Helpful answer","response.positive-feedback.well-written-response":"Well-written response","response.quote-source.jump":"Jump to quoted message","route-error.cta":"Try again","route-error.description":"This page failed to load. Please try again.","route-error.title":"Something went wrong","searches_one":"<n>{{count}}</n> search","searches_other":"<n>{{count}}</n> searches","settings-tab.team-advanced":"Advanced","settings:finance.financial-account":"Financial account","settings:finance.linked-account":"Linked account","settings:finance.linked-institution":"Linked institution","settings:finance.mention-section":"Financial institutions","settings:mcp-connectors.no-connectors-available":"No connectors available","settings:mcp-connectors.no-search-results":"No connectors match your search.","share-dialog-close-label":"Close","share-dialog-disabled-description":"Your organization administrator has disabled sharing. Contact your admin for more information.","share-dialog-disabled-title":"Sharing is disabled for your organization","share-dialog.done":"Done","share-dialog.error-loading-data":"There was an error loading the share data. Please try again later.","share-dialog.loading-more":"Loading more","share-dialog.must-select-tooltip":"You must select someone to share with","share-dialog.no-teams-placeholder":"No other teams available","share-dialog.no-users-placeholder":"No users found","share-dialog.save-failed":"Failed to save share settings","share-dialog.shared-publicly-description":"Allow anyone to access","share-dialog.shared-publicly-title":"Everyone","share-dialog.shared-with-org-description":"Allow all teams in your organization to access","share-dialog.shared-with-org-title":"Organization","share-dialog.shared-with-other-teams-title":"Other Teams","share-dialog.shared-with-team-description":"Allow members from {{team}} to access","share-dialog.shared-with-users-title":"Specific Team Members","share-dialog.sharing-disabled-by-admin":"Sharing is disabled by your team admin","share-dialog.team-search-placeholder":"Search teams...","share-dialog.user-search-footer":"Showing {{loaded}} of {{total}}","share-dialog.user-search-placeholder":"Search team members…","share-disabled-description":"Your organization administrator has disabled sharing. Contact your admin for more information.","share-disabled-title":"Sharing is disabled for your organization","share-links-page-error.cta":"Return home","share-links.description.personal":"Shared links can be viewed by anyone with the link.","share-links.description.team":"Shared links can be viewed by team members with access.","share-links.error.description":"Can\'t load shared conversations","share-links.no-share-links-found":"Nothing shared yet","share-links.remove":"Unshare","share-links.title":"Shared Conversations","share-links.unknown-conversation":"Untitled","share-links.views_one":"{{count}} view","share-links.views_other":"{{count}} views","share-skill-dialog-title":"Share \\"{{name}}\\"","share-skill-load-failed":"Failed to load sharing settings","share-skill-remove":"Remove","share-skill-update-failed":"Failed to update sharing","share.loading":"Loading…","share.warning.description":"Anyone with the link can read this conversation.","share.warning.title":"This link is public","sharepoint-browser.load-error-title":"Unable to load SharePoint","sharepoint-files-dialog.title":"SharePoint files","sharepoint-workdir.browser-title":"Choose SharePoint folder","shortcuts.command-menu":"Command Menu","shortcuts.cycle-mode":"Cycle Mode","shortcuts.dictation":"Hold to Dictate","shortcuts.focus-input":"Focus Input","shortcuts.new-chat":"New Chat","shortcuts.new-incognito-chat":"New Incognito Chat","shortcuts.open-model-picker":"Open Model Picker","shortcuts.settings":"Settings","shortcuts.share-link":"Share Link","shortcuts.submit":"Submit","shortcuts.switch-model":"Switch Model","shortcuts.toggle-right-panel":"Toggle Right Panel","shortcuts.toggle-sidebar":"Toggle Sidebar","shortcuts.voice-mode":"Enter Voice Mode","show-less":"Show less","show-more":"Show more","side-nav-toggle-button":"Toggle sidebar","side-panel-close-button.label":"Close side panel","sidebar-add-project":"Add project","sidebar-all-projects":"All projects","sidebar-automations-nav":"Automations","sidebar-back-to-grok-chat":"Chat","sidebar-bucket-earlier":"Earlier","sidebar-bucket-today":"Today","sidebar-bucket-yesterday":"Yesterday","sidebar-chat-nav":"New Chat","sidebar-chat-nav-unified":"Chat","sidebar-chats":"Chats","sidebar-collapse":"Collapse","sidebar-connectors-nav":"Connectors","sidebar-customize-nav":"Customize","sidebar-expand":"Expand","sidebar-filter-projects":"Filter projects","sidebar-filter-projects-all":"All","sidebar-filter-projects-chats":"Chats","sidebar-filter-projects-imagine":"Imagine","sidebar-history":"History","sidebar-history-loading":"Loading history","sidebar-imagine-create":"New Generation","sidebar-imagine-title":"Imagine","sidebar-library-nav":"Library","sidebar-plugins-nav":"Plugins","sidebar-projects-loading":"Loading…","sidebar-projects-more":"More","sidebar-search":"Search","sidebar-skills-and-connectors-nav":"Skills and Connectors","sidebar-skills-nav":"Skills","sidebar-workspaces-nav":"Projects","skills-added-by":"Added by","skills-added-by-you":"You","skills-and-connectors-add":"Add","skills-and-connectors-add-aria":"Add {{connectorName}}","skills-and-connectors-added":"Added","skills-and-connectors-connected":"Connected","skills-and-connectors-connector-deep-link-failed":"Could not open connector — you may not have access","skills-and-connectors-connector-deep-link-failed-ok":"OK","skills-and-connectors-connector-deep-link-failed-title":"Could not open connector","skills-and-connectors-featured":"Featured","skills-and-connectors-installed":"Installed","skills-and-connectors-needs-attention":"Needs attention","skills-and-connectors-new-connector":"New Connector","skills-and-connectors-new-skill":"New Skill","skills-and-connectors-no-results":"No results match your search.","skills-and-connectors-page-title":"Skills and Connectors","skills-and-connectors-search-placeholder":"Search...","skills-and-connectors-see-more":"See more","skills-and-connectors-show-less":"Show less","skills-and-connectors-tab-connectors":"Connectors","skills-and-connectors-tab-skills":"Skills","skills-back-to-all":"All skills","skills-binary-preview":"Download the skill to view this file","skills-bundled-docx-desc":"Generate professional documents like reports, letters, and proposals from scratch, or read and modify existing Word files. Grok can format text with headings, bullet points, and tables, apply consistent styling, and export polished .docx files — no office software required. Upload a draft to get it restructured and polished, or describe what you need and receive a ready-to-send document in seconds. Great for contracts, resumes, SOPs, and any structured writing workflow.","skills-bundled-docx.employee-handbook.preview":"Write an employee handbook covering onboarding, policies, and benefits","skills-bundled-docx.employee-handbook.prompt":"Write and display an employee handbook for SpaceX in Word covering first-week onboarding steps, remote-work and PTO policies, and health insurance benefits. Then display the Word file.","skills-bundled-docx.product-requirements.preview":"Draft a product requirements document for a mobile fitness app","skills-bundled-docx.product-requirements.prompt":"Create a product requirements document in Word format for a mobile fitness tracking app, with images displaying the logo and screenshots of the app. Then display the Word file.","skills-bundled-docx.project-proposal.preview":"Draft a project proposal for redesigning a car company website","skills-bundled-docx.project-proposal.prompt":"Draft a project proposal for redesigning a car company website, which includes compelling visual assets showcasing the car in nature. One page includes a summary of key goals to increase customer awareness, call to action, and conversion. Another page includes concrete timelines with budget information.","skills-bundled-docx.resume-builder.preview":"Build a one-page professional resume for a data scientist","skills-bundled-docx.resume-builder.prompt":"Create a one-page professional resume in Word which includes relevant work experience and highlights personal projects that are reasonable for an entry-level data scientist. Use appropriate fonts and formatting to ensure that there is minimal blank space. Display the file followed by an inline cover letter.","skills-bundled-docx.sales-invoice.preview":"Create a professional enterprise sales invoice","skills-bundled-docx.sales-invoice.prompt":"Create a clean, professional, realistic enterprise invoice on white background using Word. Use a formal corporate layout with sans serif fonts and tables in the main section, which includes services and cost (in USD). Include a concise payment terms paragraph. Add a bottom signature section in a formal box style with two side-by-side columns for name, title, company, signature, and date.","skills-bundled-docx.website-redesign.preview":"Create a project proposal for a website redesign with a summary, timeline, and budget","skills-bundled-docx.website-redesign.prompt":"Create and display a project proposal in Word for a website redesign for x.com, including an executive summary, a 3-month delivery timeline, and an itemized budget. Then display the Word file.","skills-bundled-ffmpeg-desc":"Process media files with ffmpeg — convert between formats, trim clips, resize videos, compress for sharing, extract frames or audio tracks, make GIFs, add subtitles and overlays, combine multiple videos into one, and more. Upload a video to have it inspected, optimized for web playback, or transformed to fit your needs. Grok handles codec selection, quality settings, and compatibility so you get the right output without memorizing ffmpeg commands.","skills-bundled-ffmpeg.countdown-timer.preview":"Create an animated countdown timer video with bold numbers on a black background","skills-bundled-ffmpeg.countdown-timer.prompt":"Create a 5-second animated countdown timer video from 5 to 1 with bold white numbers on a black background at 1080p. Then display the video.","skills-bundled-ffmpeg.game-of-life.preview":"Build a Game of Life cellular automaton simulation video","skills-bundled-ffmpeg.game-of-life.prompt":"Build a 10-second Game of Life cellular automaton simulation video at 1080p. Then display the video.","skills-bundled-ffmpeg.intro-video.preview":"Generate an intro video with a fade-in title on a dark gradient background","skills-bundled-ffmpeg.intro-video.prompt":"Generate a 5-second intro video with a fade-in title on a cinematic dark gradient background at 1080p. Then display the video.","skills-bundled-memory-edit-desc":"Help Grok build and maintain a personal memory of you so future conversations feel more tailored. You can make changes manually or ask Grok to ask you questions about yourself to fill out a robust profile of you.","skills-bundled-memory-edit.fill-gaps.preview":"Fill gaps in what you know about me","skills-bundled-memory-edit.fill-gaps.prompt":"Ask me 3 questions, one at a time, to fill gaps in what you know about me — things like my work, where I live, hobbies, and daily routines. Skip anything already in your memory and keep each question answerable in a sentence or less. After each answer, follow the memory-edit skill to decide what’s worth keeping and actually save it to your memory (merging or adding as needed) before asking the next question — don’t just summarize it in the chat. When we’re done, tell me what you saved.","skills-bundled-memory-edit.goals.preview":"Get to know my goals and what I’m working toward","skills-bundled-memory-edit.goals.prompt":"Ask me 3 questions, one at a time, about my goals and plans — what I’m working toward, projects I care about, and things I want to learn. Keep each one short and easy to answer, and skip anything you already know. After each answer, use the memory-edit skill to actually save what’s worth keeping to your memory before asking the next question — update it, don’t just note it in the chat. At the end, confirm what you saved.","skills-bundled-memory-edit.preferences.preview":"Learn how I like you to help me","skills-bundled-memory-edit.preferences.prompt":"Ask me 3 questions, one at a time, to learn my preferences — how I like your responses (length, tone, format), the topics and tools I care about, and my pet peeves. After each answer, follow the memory-edit skill and actually save anything worth remembering to your memory before the next question, rather than just summarizing it in the chat. When we’re finished, tell me what you saved.","skills-bundled-pdf-desc":"Extract text and data from PDF files, merge multiple documents into one, split large files into sections, or create new PDFs from scratch. Grok can read scanned documents, pull out key figures and tables, and reformat content for easy consumption. Ideal for processing invoices, contracts, research papers, legal filings, and any document workflow that involves the PDF format.","skills-bundled-pdf.ai-history-report.preview":"Write a PDF report on the history and impact of artificial intelligence","skills-bundled-pdf.ai-history-report.prompt":"Create a polished PDF report on the history and impact of artificial intelligence with a title page. Skip the table of contents page. Then display the PDF file.","skills-bundled-pdf.event-poster-alt.preview":"Design a Mondrian-inspired music event poster","skills-bundled-pdf.event-poster-alt.prompt":"Design a bold, graphic one-page portrait music event poster PDF inspired by Mondrian, using an asymmetric grid with thick black lines and primary color blocks. Prioritize a striking, art-forward composition with a large dominant band name spanning sections and expressive condensed typography interacting with the grid. Arrange supporting details (blurb, date, time, location, website, price) with clear hierarchy and high contrast, keeping the layout dynamic, cinematic, and legible.","skills-bundled-pdf.keyboard-shortcuts.preview":"Create a one-page PDF cheat sheet of macOS keyboard shortcuts","skills-bundled-pdf.keyboard-shortcuts.prompt":"Create a concise one-page PDF cheat sheet of essential keyboard shortcuts for macOS with retro themes. Then display the PDF file.","skills-bundled-pdf.latex-report.preview":"Generate a LaTeX PDF report on AI interpretability","skills-bundled-pdf.latex-report.prompt":"Generate a PDF report in LaTeX that covers AI interpretability in under 5 pages. This document will be used as a conference or journal submission, so the first page should include lines above and below the title, authors with affiliations and emails, an abstract, and an introduction. All mathematical formulas and citations should be properly formatted. All text is black on a white background.","skills-bundled-pdf.transformer-latex.preview":"Generate a LaTeX PDF that explains the Transformer architecture","skills-bundled-pdf.transformer-latex.prompt":"Generate a PDF that explains the Transformer architecture from \\"Attention Is All You Need\\", using LaTeX. Then display the PDF file.","skills-bundled-pdf.travel-escape.preview":"Create a cinematic 3-day Hawaii travel plan","skills-bundled-pdf.travel-escape.prompt":"Create a visually immersive 3-day Hawaii travel plan presented like a cinematic editorial spread. Include flights, a 5-star hotel, total costs, and curated daily experiences (snorkeling, hiking, seasonal dining). Use minimal, refined text in PDF format paired with large, high-impact imagery that evokes modern luxury, warmth, and effortless escape, with a cohesive, film-like aesthetic and strong visual storytelling.","skills-bundled-pptx-desc":"Build slide decks from scratch, update existing presentations, or extract content from PowerPoint files. Grok can create titled slides with bullet points, speaker notes, and structured layouts for meetings, pitches, lectures, or training sessions. Provide a topic or outline and get a complete deck with consistent formatting, or upload an existing file to have it revised, condensed, or expanded.","skills-bundled-pptx.business-presentation.preview":"Design a quarterly business review deck","skills-bundled-pptx.business-presentation.prompt":"Design a 5-slide quarterly business review deck in a clean, consulting-grade layout with bold composition and strong visual hierarchy. Use refined sans-serif typography, deep text on white, and generous margins. Include a KPI slide with clear status indicators, and two slides with large, high-impact charts paired with concise bullet takeaways. Use scale, contrast, and layout variation to create a visually engaging, polished, top-tier presentation while maintaining clarity and spacing.","skills-bundled-pptx.leadership-workshop.preview":"Create a leadership and strategic thinking workshop deck","skills-bundled-pptx.leadership-workshop.prompt":"Create a polished 5-slide leadership and strategic thinking workshop presentation with a clean, modern editorial layout in a neutral palette. Use strong typographic hierarchy, minimal text, and clear structure. Include slides on strategic thinking, decision-making, communication, and emotional intelligence. Use cohesive abstract, conceptual, or stylized imagery to support each theme.","skills-bundled-pptx.pitch-deck.preview":"Create a pitch deck for an AI-powered enterprise startup","skills-bundled-pptx.pitch-deck.prompt":"Create a 5-slide pitch deck for an AI-powered enterprise startup using a sleek, modern, editorial layout and a minimalist logo. Use bold composition, minimal copy, and strong hierarchy to create visually striking slides. Include a clear data-driven slide for revenue and growth, and a focused slide on proprietary advantage. Maintain a polished, cohesive, investor-ready aesthetic throughout.","skills-bundled-pptx.quarterly-review.preview":"Design a quarterly business review deck with KPIs and goals","skills-bundled-pptx.quarterly-review.prompt":"Design a business review PowerPoint for SpaceX showing KPIs, top 3 customer wins, and next-quarter OKRs. Search for relevant images to use in the presentation. Then display the PowerPoint file.","skills-bundled-pptx.startup-pitch.preview":"Create a pitch deck for an AI-powered productivity startup","skills-bundled-pptx.startup-pitch.prompt":"Create a 10-slide pitch deck for a startup building AI-powered productivity tools using the Grok API. Then display the PowerPoint file.","skills-bundled-pptx.training-workshop.preview":"Build a training workshop presentation on remote team communication","skills-bundled-pptx.training-workshop.prompt":"Build a training workshop PPT presentation on effective remote team communication at SpaceX. Then display the PowerPoint file.","skills-bundled-skill-creator-desc":"Build custom skills that teach Grok new capabilities. Define what your skill does, set behavioral guidelines, and specify the tools or data sources it should use. Grok generates the necessary SKILL.md instruction file so your skill is ready to use immediately. Use it to create domain-specific assistants, enforce coding standards, automate repetitive workflows, or package expert knowledge into a reusable format that anyone on your team can invoke.","skills-bundled-skill-creator.python-reviewer.preview":"Make a skill that acts as a code reviewer for Python projects","skills-bundled-skill-creator.python-reviewer.prompt":"Make a skill that acts as a code reviewer for Python projects following PEP 8. Then display the skill instructions.","skills-bundled-skill-creator.sql-review.preview":"Create a skill that helps write and review SQL queries","skills-bundled-skill-creator.sql-review.prompt":"Create a skill that helps me write and review SQL queries for PostgreSQL. Then display the skill instructions.","skills-bundled-skill-creator.status-reports.preview":"Build a skill for generating weekly project status reports","skills-bundled-skill-creator.status-reports.prompt":"Build a skill for generating weekly project status reports with structured sections and action items. Then display the skill instructions.","skills-bundled-skill-installer-desc":"Browse and install community-created skills hosted on GitHub. Preview what a skill can do, review its instructions, and add it to your Grok setup with a single command. Keep your skills up to date by reinstalling from the latest repository version. Share a GitHub URL and Grok will fetch the skill definition, validate its contents, and install it so you can start using it right away.","skills-bundled-skill-installer.browse-productivity.preview":"Browse community skills and recommend the best ones for productivity","skills-bundled-skill-installer.browse-productivity.prompt":"Browse available community skills and recommend the best ones for productivity","skills-bundled-skill-installer.code-review-compare.preview":"List community skills for code review and compare them","skills-bundled-skill-installer.code-review-compare.prompt":"List community skills for code review and explain what each one does","skills-bundled-skill-installer.data-analysis.preview":"Find popular Grok skills on GitHub for data analysis","skills-bundled-skill-installer.data-analysis.prompt":"Find popular Grok skills on GitHub for data analysis","skills-bundled-xlsx-desc":"Generate formatted spreadsheets, analyze data in existing files, and produce structured outputs in .xlsx or .csv format. Upload a file to get summary statistics, trend analysis, or cleaned-up data, or describe a layout and receive a ready-made spreadsheet. Use it for financial reports, data tracking, inventory management, budgets, or any task that calls for rows, columns, and calculations.","skills-bundled-xlsx.budget-tracker.preview":"Create a monthly budget tracker with income, expenses, and savings","skills-bundled-xlsx.budget-tracker.prompt":"Create a monthly household budget spreadsheet for a $15,000/month income with rent, groceries, utilities, subscriptions, and a 20% savings goal for a couple in San Francisco. Then display the spreadsheet.","skills-bundled-xlsx.corporate-forecast.preview":"Build a B2B corporate finance forecast spreadsheet","skills-bundled-xlsx.corporate-forecast.prompt":"Build an Excel spreadsheet for a B2B Corporate Finance team that includes rolling forecasts that consolidate inputs from multiple departments. Link assumptions and driver tabs (headcount, product pricing, volume, inflation) with what-if toggles. Include detailed variance analysis (actual vs. budget, prior year, and forecast) with automated flags for exceeding budget. Include scenario planning for a new product launch and cost-cutting.","skills-bundled-xlsx.event-plan.preview":"Generate a corporate off-site event planning spreadsheet","skills-bundled-xlsx.event-plan.prompt":"Generate a corporate off-site event planning Excel spreadsheet with a clean, structured layout and clear column grouping for tasks, vendors, budgets, and timelines. Use color-coded sections to differentiate categories, with consistent labels, subtle hierarchy, and easy-to-scan formatting. Maintain a polished, organized, and visually intuitive design.","skills-bundled-xlsx.launch-tracker.preview":"Build a product launch tracker with tasks, owners, and deadlines","skills-bundled-xlsx.launch-tracker.prompt":"Build a product launch tracker spreadsheet for Starlink with 20 tasks across engineering, design, and marketing, each with an owner and deadline. Then display the spreadsheet.","skills-bundled-xlsx.monthly-budget.preview":"Create a monthly budget tracker with income, expenses, and savings","skills-bundled-xlsx.monthly-budget.prompt":"Create a monthly budget tracker in Excel with a clean, structured layout grouping income, expenses, and savings into clearly defined sections. Include expense categories (rent, car payments, credit cards) and savings (401(k), Roth). Use clear hierarchy, consistent formatting, and subtle color-coding to create an intuitive, easy-to-scan, and visually organized tracker. Include the file in your final response.","skills-bundled-xlsx.sales-dashboard.preview":"Generate a sales dashboard with monthly targets and actual revenue","skills-bundled-xlsx.sales-dashboard.prompt":"Generate a sample sales dashboard spreadsheet for SpaceX with monthly quotas, actual revenue, close rates, and a YTD summary row. Then display the spreadsheet.","skills-collision-bundled":"A bundled skill named \\"{{name}}\\" already exists. Your uploaded skill will overwrite it.","skills-collision-user":"You already have a skill named \\"{{name}}\\". Your uploaded skill will overwrite it.","skills-create-success":"Skill created","skills-create-upload":"Upload skill file","skills-create-with-grok":"Create skill with Grok","skills-create-write":"Write skill manually","skills-created-by":"Created by","skills-created-by-org":"Your organization","skills-deep-link-preview-failed":"Could not open skill — you may not have access","skills-delete":"Delete","skills-desc-placeholder":"Predicts the weather","skills-description":"Description","skills-dialog-back":"Back","skills-dialog-cancel":"Cancel","skills-dialog-save":"Save","skills-disable":"Disable","skills-disable-skill":"Disable skill","skills-download":"Download","skills-edit":"Edit","skills-edit-success":"Skill updated","skills-edit-title":"Edit Skill","skills-enable":"Enable","skills-enable-skill":"Enable skill","skills-field-description":"Description","skills-field-instruction":"Instruction","skills-field-name":"Name","skills-file-count":"Files","skills-file-search-empty":"No files match your search.","skills-file-search-placeholder":"Search files...","skills-file-view-preview":"Preview","skills-file-view-raw":"Raw","skills-hide-failed":"Failed to hide skill","skills-install":"Install","skills-install-failed":"Failed to install skill","skills-install-success":"Skill installed","skills-instructions-placeholder":"Using web search, find the current weather for the given location...","skills-last-updated":"Last Updated","skills-loading-more":"Loading...","skills-logged-out.description":"Teach Grok new ways to work by adding custom skills tailored to your workflows.","skills-logged-out.title":"Supercharge Grok with Skills","skills-more":"More options","skills-more-options":"More options","skills-name-placeholder":"weather-predictor","skills-new-title":"New Skill","skills-no-description":"No description provided.","skills-overridden":"Grok will use your \\"{{name}}\\" custom skill instead.","skills-page-title":"Skills","skills-promote-dialog.cancel":"Cancel","skills-promote-dialog.keep-option.title":"Keep my personal copy","skills-promote-to-verified":"Add to verified skills","skills-promote-to-verified-failed":"Failed to add skill to verified skills","skills-promote-to-verified-success":"Skill added to verified skills","skills-promote-verified-dialog.description":"This adds the skill to your organization\'s verified skills library. Admins can then publish it to members, who can install it. This is separate from the Share setting and still works when sharing is turned off. Choose what happens to your personal copy.","skills-promote-verified-dialog.keep-option.description":"Adds a separate copy to verified skills. Your personal skill stays, but edits you make to it later won\'t be reflected in the verified skill.","skills-promote-verified-dialog.remove-option.description":"Removes the skill from your personal list. It will only exist as a verified skill.","skills-promote-verified-dialog.remove-option.title":"Move to verified skills","skills-promote-verified-dialog.title":"Add \\"{{skillName}}\\" to verified skills?","skills-remove-for-me":"Remove for me","skills-rename-collision-bundled":"A bundled skill named \\"{{name}}\\" already exists. Saving will replace it with your version.","skills-rename-collision-user":"You already have a skill named \\"{{name}}\\". Saving will overwrite it.","skills-section-personal":"Personal","skills-section-shared":"Shared with you","skills-section-verified":"Verified","skills-share":"Share","skills-share-link-copied":"Share link copied to clipboard","skills-share-link-failed":"Failed to create share link","skills-share-link-preview-failed":"Could not load shared skill","skills-shared-by-someone":"Someone","skills-show-more":"Show more","skills-total-size":"Size","skills-try-draft":"Use the {{skillName}} skill to","skills-try-it-now":"Try it now","skills-try-it-out":"Try it out","skills-type":"Type","skills-type-bundled":"Bundled","skills-upload-browse":"or click to browse","skills-upload-confirm":"Confirm","skills-upload-drop":"Drop a .zip, .skill, or .md file here","skills-upload-invalid-type":"Only .zip, .skill, and .md files are accepted","skills-upload-skip-collision-confirm":"Don\'t show this again","skills-upload-success":"Skill uploaded","skills-upload-title":"Upload Skill","skills-uploading":"Uploading...","skills-verified-empty.label":"No verified skills yet. Use \\"Add to verified skills\\" on a personal skill.","skills-verified-publish":"Publish","skills-verified-remove":"Remove","skills-verified-remove-failed":"Failed to remove verified skill","skills-verified-remove-success":"Removed from verified skills","skills-verified-tooltip":"Skills verified by your organization\'s admins","skip-to-main-content.label":"Skip to main content","splash-page.available-on-ios-and-android":"Available on iOS and Android","splash-page.grok-is-better-in-the-app":"Grok is better in the app","splash-page.open-grok":"Open Grok","splash-page.view-in-the-grok-app":"View in the Grok app","splash-page.view-this-link-in-the-grok-app":"View this link in the Grok app","sport-team-position-header.position-in-league":"{{position}} in {{leagueName}}","sports-card.completed":"Completed","sports-card.in-progress":"In Progress","sports-card.upcoming":"Upcoming","stop-stream-button-label":"Stop model response","superGrok-upsell-dialog.title":"Upgrade to SuperGrok","svg-diagram.download":"Download","svg-diagram.failed-to-render":"Failed to render SVG","svg-diagram.generating":"Rendering SVG","svg-diagram.view-raw":"View raw","switch-team.cta":"Switch to {{teamName}}","switch-team.description":"Switch to {{teamName}} to access this conversation.","switch-team.invalid-license.description":"You don\'t have access to this team. Please contact the team admin to gain access.","switch-team.invalid-license.title":"Access Denied","switch-team.personal":"Personal","switch-team.switching-message":"Switching to {{teamName}}","switch-team.title":"Switch Workspace","table.collapse":"Collapse table","table.copy-table-2":"Copy table","table.expand":"Expand table","table.save":"Save table","table.save-error":"Failed to save table","team-insights.error-loading-data":"Could not load data","team-insights.see-all":"See all","team-insights.shared-with-me":"Shared with me","team-management.actions.cancel-licenses":"Cancel licenses","team-management.actions.cancel-licenses.actions.submit":"Cancel licenses","team-management.actions.cancel-licenses.actions.submitting":"Cancelling…","team-management.actions.cancel-licenses.already-cancelled":"Already cancelled","team-management.actions.cancel-licenses.amount.label":"How many licenses to cancel?","team-management.actions.cancel-licenses.amount.placeholder":"Enter the number of licenses to cancel…","team-management.actions.cancel-licenses.cancellable-count":"Licenses available to cancel","team-management.actions.cancel-licenses.complete.description":"Your licenses have been set to cancel and will expire at the end of their renewal period.","team-management.actions.cancel-licenses.complete.dismiss":"Done","team-management.actions.cancel-licenses.complete.title":"Licenses cancelled","team-management.actions.cancel-licenses.description":"Cancel licenses which will be removed from your team.","team-management.actions.cancel-licenses.error.all-cancelled":"All licenses have already been cancelled.","team-management.actions.cancel-licenses.error.exceeds-cancellable_one":"You can only cancel {{count}} more license(s).","team-management.actions.cancel-licenses.error.exceeds-cancellable_other":"You can only cancel {{count}} more license(s).","team-management.actions.cancel-licenses.error.submit":"Could not cancel licenses. Try again later.","team-management.actions.cancel-licenses.invalid-permissions.action":"Close","team-management.actions.cancel-licenses.invalid-permissions.description":"You do not have permission to cancel licenses. Contact your team admin.","team-management.actions.cancel-licenses.invalid-permissions.title":"Please contact your team admin","team-management.actions.cancel-licenses.license-type":"License type","team-management.actions.cancel-licenses.new-total-count":"Total licenses after change","team-management.actions.cancel-licenses.title":"Cancel licenses","team-management.actions.cancel-licenses.total-count":"Total licenses","team-management.actions.cancel-licenses.warning.assigned_one":"Warning: {{count}} assigned license(s) will be cancelled. Users with these licenses will lose access at the end of the billing period.","team-management.actions.cancel-licenses.warning.assigned_other":"Warning: {{count}} assigned license(s) will be cancelled. Users with these licenses will lose access at the end of the billing period.","team-management.actions.feedback.description":"Share your thoughts on Grok Business","team-management.actions.feedback.error":"Could not submit feedback. Try again later.","team-management.actions.feedback.placeholder":"Enter your feedback…","team-management.actions.feedback.required":"This field is required","team-management.actions.feedback.submit":"Submit","team-management.actions.feedback.success.description":"Thank you for your feedback!","team-management.actions.feedback.success.done":"Done","team-management.actions.feedback.success.title":"Feedback submitted","team-management.actions.feedback.title":"Leave feedback","team-management.actions.leave-feedback":"Leave feedback","team-management.actions.open-menu":"Show actions","team-management.actions.read-docs":"Read Documentation","team-management.actions.title":"Actions","team-management.add-user.cta-plural":"Add Users","team-management.add-user.description":"Invite teammates by email. Each invite uses one available license.","team-management.add-user.description-links":"Invited users will get an invite link in the invitations table. Each invite uses one available license.","team-management.add-user.emails.invalid":"Not a valid email address","team-management.add-user.emails.label":"Email addresses","team-management.add-user.emails.placeholder-search":"Search people or enter email addresses…","team-management.add-user.emails.remove":"Remove {{email}}","team-management.add-user.emails.remove-action":"Remove","team-management.add-user.error":"Failed to send invitations. Please try again.","team-management.add-user.errors.no-invites":"Enter at least one valid email address.","team-management.add-user.license-type":"License type","team-management.add-user.license-type.unavailable":"No {{product}} licenses available","team-management.add-user.submit":"Send invitations","team-management.add-user.submitting":"Sending…","team-management.add-user.success.description_one":"{{count}} invitation(s) sent.","team-management.add-user.success.description_other":"{{count}} invitation(s) sent.","team-management.add-user.success.title":"Invitations sent","team-management.add-user.suggestions-label":"Organization members","team-management.add-user.title":"Add users","team-management.apps.add":"Add Connector","team-management.apps.allowed-sites.add":"Add","team-management.apps.allowed-sites.add-help":"Use the SharePoint site ID or site path your IT admin provides.","team-management.apps.allowed-sites.add-label":"Add site ID","team-management.apps.allowed-sites.add-placeholder":"e.g. contoso.sharepoint.com,sites/Engineering","team-management.apps.allowed-sites.description":"Grok can only access the SharePoint sites listed below. Add site IDs from Azure or SharePoint admin.","team-management.apps.allowed-sites.duplicate":"That site ID is already listed.","team-management.apps.allowed-sites.empty":"No sites allowed yet. Add at least one site ID.","team-management.apps.allowed-sites.error":"Failed to load allowed sites.","team-management.apps.allowed-sites.headers.actions":"Actions","team-management.apps.allowed-sites.headers.site":"Site ID","team-management.apps.allowed-sites.remove":"Remove site","team-management.apps.allowed-sites.retry":"Try again","team-management.apps.allowed-sites.save":"Save","team-management.apps.allowed-sites.save-error":"Failed to update allowed sites","team-management.apps.allowed-sites.save-success":"Allowed sites updated","team-management.apps.allowed-sites.saving":"Saving…","team-management.apps.allowed-sites.wrong-mode":"Allowed sites only apply when SharePoint is connected with application permissions (Sites.Selected). This connector uses delegated auth,