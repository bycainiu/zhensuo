;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="97509825-35fb-6fd7-b28c-6a0e407d637b")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,3511869,(e,r,t)=>{r.exports=JSON.parse('{"Add to chat":"添加到聊天","Anonymous":"匿名","Ask Grok":"問 Grok","Ask anything":"畅所欲问","Back":"返回","Cancel":"取消","Close":"关闭","Close search":"关闭搜索","Contact Support":"联系客服","Content Moderated":"内容受限。换个想法再试试。","Content is empty":"内容为空","Continue":"继续","Copied!":"已复制！","Copy":"复制","Could not load document.":"无法加载文档。","Create share link":"创建共享链接","Deep Search: Browsed URLs":"Deep Search：已检索的网址","Documents":"文档","Download":"下载","Download Asset":"下载资源","Enter prompt here":"在此输入提示词","Explain":"解释","Explain this":"解释此内容","Failed to load image":"加载图片失败","Files":"文件","Generate more images like this":"生成更多类似图片","Go to page":"跳转到页面","Good afternoon, {{username}}.":"下午好，{{username}}。","Good evening, {{username}}.":"晚上好，{{username}}。","Good morning, {{username}}.":"早上好，{{username}}。","Grok was unable to finish replying.description":"请稍后再试或使用其他模型。","Grok was unable to finish replying.errorMessage":"Grok 无法完成回复。","Grok was unable to reply.description":"请尝试重新生成回应。","Grok was unable to reply.errorMessage":"Grok 无法回复你的上一条消息。","Hello":"你好","Home page":"主页","Loading Older Messages":"载入较早的信息","Loading text…":"正在加载文本…","Mobile":"移动设备","Next result":"下一个结果","No content available.":"没有可用的内容。","No text content available.":"没有可用的文本内容。","Open in New Tab":"在新标签页中打开","Open in new tab":"在新标签页中打开","Original image to edit":"待编辑的原始图片","Page":"页","Page number":"页码","Prefer this response":"更喜欢此回应","Previous result":"上一个结果","Problem playing audio":"播放音频时出现问题","Quick Answer":"快速回答","Quote":"引用","Rate Limit Reached.description":"{{modelName}} 已达查询上限，限额将于 {{time}} 重置。","Reconnecting...":"正在重新连接...","Refresh":"刷新","Reload":"重新加载","Response letter":"回复 {{letter}}","Retry":"重试","Return to Home":"返回主页","Save":"保存","Search":"搜索","Search Results":"搜索结果","Share conversation with team":"与团队共享对话","Skip Selection":"跳过选择","Something went wrong when loading the document.":"加载文档时出现错误。","Source":"来源","Sources":"来源","Switch to Default Chat":"切换到默认聊天","Switch to Private Chat":"切换到私密聊天","There was an error":"发生错误","Think Harder":"Think 让你思考更深入","Thinking-content-override":"思考中……","This will help make Grok better.":"这将有助于使 Grok 变得更好。","Thoughts":"思考结果","Try again or ":"请重试或 ","Unauthenticated.description":"请登录或刷新页面","Unauthenticated.errorMessage":"无法确认用户身份。","Update share link":"更新共享链接","Waiting-for-thinking":"正在等待所有回应完成思维。","Welcome to Grok.":"欢迎使用 Grok。","Which response do you prefer?":"你更喜欢哪个回复？","Wide":"网页版","Zoom in":"放大","Zoom out":"缩小","anon-chat-not-found-error.cta":"开始新聊天","anon-chat-not-found-error.description":"登录以请求访问权限","anon-chat-not-found-error.sign-in":"登录","anon-chat-not-found-error.title":"这是私人聊天","app-grant.already-granted":"{{connector}} 已授予","app-grant.already-granted-v2":"{{connector}} 已授予 — 选择以重新批准","app-grant.approve":"允许 {{connector}}","app-grant.body":"{{app}} 正在请求使用您的 {{connector}} 连接，以便已连接 {{connector}} 的查看者可以在应用中使用这些工具。您可以稍后撤销此权限。","app-grant.deny":"稍后再说","app-grant.error":"无法授予访问权限。请重试。","app-grant.granted-pill":"{{connector}} ✓","app-grant.pick-connector":"选择一个连接","app-grant.success":"已授予访问权限。您的应用可以使用 {{connector}}。","app-grant.this-app":"此应用","app-grant.title":"允许连接器访问？","ask-user-question.answer":"答案","ask-user-question.answers":"答案","ask-user-question.custom-answer":"自定义答案","ask-user-question.dismiss":"忽略问题","ask-user-question.done":"完成","ask-user-question.next":"下一个","ask-user-question.no-answer":"(无答复)","ask-user-question.previous":"上一个问题","ask-user-question.question":"问题","ask-user-question.questions":"问题","ask-user-question.step":"第 {{current}} 个，共 {{total}} 个","asset-viewer.expand-image":"全屏查看图像","asset-viewer.expand-video":"全屏查看视频","asset-viewer.video":"视频","asset-viewer.video-load-error":"无法播放此视频。","audio-player.mute-button.label":"静音","audio-player.pause-button.label":"暂停","audio-player.play-button.label":"播放","audio-player.seek-slider.label":"定位","audio-player.unmute-button.label":"取消静音","autocomplete_suggestion_copy.label":"复制到剪贴板","autocomplete_suggestion_copy.toast":"已复制到剪贴板","background-tasks-tray.delete-failed.toast":"无法删除定时任务","background-tasks-tray.delete-scheduled-button.label":"删除定时任务","background-tasks-tray.kill-button.label":"停止任务","background-tasks-tray.kill-failed.toast":"无法停止任务","background-tasks-tray.next-fire-soon.label":"即将","background-tasks-tray.title":"后台任务","background-tasks-tray.toggle-button.label":"切换后台任务","build-mode-hint.cta":"切换","build-mode-hint.dismiss":"忽略","build-mode-hint.subtitle":"构建模式可以将此转换为网站、游戏、应用程序或仪表板。","build-mode-hint.subtitle-short":"将其转变为网站、游戏或应用。","build-mode-hint.title":"切换到构建模式","build-mode-hint.title-short":"构建模式","build-mode-starters.example.audio.audio-visualizer.label":"音频可视化","build-mode-starters.example.audio.audio-visualizer.prompt":"构建一个音乐可视化工具，根据麦克风输入或上传的音轨显示动态条形、环形模式和不同配色主题。为音频文件加入播放和暂停功能，并提供灵敏度控制和全屏模式。确保视觉效果流畅，控件简洁且不干扰画面。","build-mode-starters.example.audio.chord-player.label":"和弦播放器","build-mode-starters.example.audio.chord-player.prompt":"构建一个和弦进行播放器，包含音阶或调性选择器、常用和弦进行预设、扫弦或琶音模式以及循环播放。加入速度控制、高亮显示当前和弦，并支持编辑和弦进行顺序。采用简洁的音乐应用界面，使其适合歌曲创作练习。","build-mode-starters.example.audio.drum-machine.label":"鼓机","build-mode-starters.example.audio.drum-machine.prompt":"制作一个带有 16 步网格的步进音序器鼓机，用于底鼓、军鼓、踩镲和打击乐，并包含速度控制和播放/停止功能。加入清空节奏型、随机生成、Swing 摇摆节奏，以及播放时的可视化步进高亮。界面采用网格化设计，支持响应式布局，并让点击交互具有令人满意的反馈感。","build-mode-starters.example.audio.synth-keyboard.label":"合成器键盘","build-mode-starters.example.audio.synth-keyboard.prompt":"创建一个可演奏的合成器键盘，包含屏幕虚拟琴键、电脑键盘按键映射、波形选择，以及滤波器和包络旋钮。加入八度切换、音量控制，以及简单的示波器或电平表。按下琴键时应显示高亮效果，并确保音频只在用户主动操作后开始播放。","build-mode-starters.example.audio.theremin.label":"特雷门琴","build-mode-starters.example.audio.theremin.prompt":"构建一个由鼠标控制的特雷门琴，将横轴映射为音高，纵轴映射为音量，并提供波形选择和混响效果。加入演奏区域的视觉指引、静音开关和简洁的音高显示。让声音富有表现力，同时使交互方式一目了然。","build-mode-starters.example.data-viz.network-graph.label":"网络图","build-mode-starters.example.data-viz.network-graph.prompt":"构建一个力导向网络图，支持拖动节点、缩放和平移，并包含连线标签和可高亮匹配节点的搜索框。提供示例图数据、点击查看节点详情的功能，以及重新激活或冻结模拟的控件。让画布铺满整个界面，同时兼顾运行性能。","build-mode-starters.example.data-viz.poll-app.label":"投票应用","build-mode-starters.example.data-viz.poll-app.prompt":"构建一个实时投票应用，用户可以创建包含多个选项的问题、进行一次投票，并通过本地状态实时查看带动画的结果条更新。加入总票数统计、百分比标签，以及重置或发起新投票的功能。确保界面响应迅速，并清晰展示已选择和不可用状态。","build-mode-starters.example.data-viz.revenue-dashboard.label":"收入仪表板","build-mode-starters.example.data-viz.revenue-dashboard.prompt":"构建一个交互式营收数据仪表盘，提供日期范围筛选，并通过 KPI 卡片展示营收、增长率和客户流失率。趋势图应根据所选日期范围实时更新。加入数据明细表、悬停提示信息和离线可用的示例数据。整体布局应具备响应式设计，并采用简洁、专业的数据分析风格。","build-mode-starters.example.data-viz.world-map.label":"世界地图","build-mode-starters.example.data-viz.world-map.prompt":"创建一张分级设色世界地图，根据某项指标为不同国家着色，并配有图例、悬停提示和指标切换器。加入示例数据、地图平移与缩放功能，以及显示所选国家详细信息的侧边面板。确保交互流畅，视觉层级清晰。","build-mode-starters.example.game.3d-maze.label":"3D 迷宫","build-mode-starters.example.game.3d-maze.prompt":"创建一款第一人称低多边形风格的 3D 迷宫游戏，支持 WASD 移动、鼠标控制视角，并在走廊中散布可收集物品。加入能够逐步显示已探索路径的小地图、计时器，以及找到出口后的胜利界面。墙体碰撞应坚实自然，整体美术风格保持简洁、轻松且富有趣味。","build-mode-starters.example.game.endless-runner.label":"无尽跑酷","build-mode-starters.example.game.endless-runner.prompt":"构建一个浏览器无尽跑酷游戏，玩家跳跃并滑行通过程序生成的障碍，这些障碍会随时间推移而变得更密集。包括单击或空格跳跃、连击计分、速度递增，以及保存在本地存储中的高分。添加一个游戏结束屏幕，支持重新开始，并为跳跃、着陆和障碍碰撞添加平滑动画。","build-mode-starters.example.game.platformer.label":"平台跳跃游戏","build-mode-starters.example.game.platformer.prompt":"创建一款 2D 平台跳跃游戏，包含奔跑、跳跃、二段跳、移动平台、金币和危险障碍。加入检查点系统、金币计数器，以及抵达后即可结束关卡的终点旗帜。使用方向键或 WASD 实现灵敏顺畅的操作，并加入简单的关卡难度选择功能，或在角色死亡后提供重新开始选项。","build-mode-starters.example.game.space-shooter.label":"太空射击","build-mode-starters.example.game.space-shooter.prompt":"制作一款俯视视角的太空射击游戏，包含多波敌人、玩家射击，以及多重射击、护盾和加速等强化道具。加入生命值、分数统计、最高分榜和暂停菜单。添加视差星空背景、开火闪光效果，并支持通过键盘或指针流畅控制飞船移动。","build-mode-starters.example.game.tower-defense.label":"塔防","build-mode-starters.example.game.tower-defense.prompt":"构建一个带有怪物路径、可放置防御塔以及通过击杀赚取金币的塔防游戏。包括多种不同范围和成本的防御塔类型、波次进度以及伤害和射速的升级路径。显示剩余生命、当前金币，以及带有重启游戏选项的游戏结束或胜利屏幕。","build-mode-starters.example.generative.flow-field.label":"流场","build-mode-starters.example.generative.flow-field.prompt":"创建一个流场艺术生成器，让漂浮粒子沿噪声场移动，并提供速度、轨迹长度和配色方案控制。加入随机种子按钮、暂停功能和 PNG 导出功能。让整个画布都成为生成式艺术区域，并使画面演化过程具有观赏性和满足感。","build-mode-starters.example.generative.fractal-tree.label":"分形树","build-mode-starters.example.generative.fractal-tree.prompt":"创建一棵生成式分形树，可调节分枝角度、递归深度和枝干长度，并加入轻柔的风吹摇摆效果。提供重新生成按钮、颜色方案控制，以及可选的树叶或花朵覆盖效果。页面加载时播放树木生长动画，让整棵树显得富有生命力。","build-mode-starters.example.generative.kaleidoscope.label":"万花筒","build-mode-starters.example.generative.kaleidoscope.prompt":"制作一个万花筒，将指针移动映射成对称的彩色图案，并支持调整分区数量和颜色模式。加入定格画面、随机生成和导出图片功能。确保动画流畅，控件简单易用，让用户可以立即上手。","build-mode-starters.example.generative.mandelbrot-zoom.label":"曼德勃罗缩放","build-mode-starters.example.generative.mandelbrot-zoom.prompt":"构建一个曼德勃罗集分形探索器，支持点击缩放、拖动平移、平滑着色和迭代次数控制。加入一些有趣位置的预设、重置视图按钮，以及注重性能的渲染方式。界面保持极简，让分形图案始终成为视觉焦点。","build-mode-starters.example.generative.particle-field.label":"粒子场","build-mode-starters.example.generative.particle-field.prompt":"构建一个交互式粒子场，让粒子以旋涡轨迹朝光标汇聚，并呈现运动拖尾和颜色渐变效果。支持调节粒子数量和作用力强度。加入清除/重置功能、背景颜色选项，以及下载截图按钮。让指针交互响应即时，并呈现丰富而绚丽的视觉效果。","build-mode-starters.example.math.fourier-drawing.label":"傅里叶绘图","build-mode-starters.example.math.fourier-drawing.prompt":"构建一个傅里叶级数演示工具，使用旋转圆重新绘制手绘或预设形状，并支持调整项数和播放速度。加入自由绘制模式、播放和暂停功能，以及重建路径的轨迹显示。确保旋转圆清晰可见，控件简单易用。","build-mode-starters.example.math.function-grapher.label":"函数绘图器","build-mode-starters.example.math.function-grapher.prompt":"构建一个交互式函数绘图工具，支持绘制一个或多个函数方程，并提供缩放、平移、网格显示和光标位置数值读取功能。加入示例函数、坐标轴标签，以及对无效输入的错误处理。绘图区应尽可能大，控制面板保持次要但清晰易用。","build-mode-starters.example.math.prime-explorer.label":"质数探索器","build-mode-starters.example.math.prime-explorer.prompt":"构建一个可视化质数探索器，使用动画演示埃拉托斯特尼筛法，支持点击整数，并为合数展示因数分解结果。加入数值范围控制、动画播放/暂停功能，以及已找到质数的列表。让整个可视化过程具有教育意义，并且清晰易懂。","build-mode-starters.example.math.probability-lab.label":"概率实验室","build-mode-starters.example.math.probability-lab.prompt":"创建一个概率模拟器，支持掷骰子和抛硬币两种模式，可配置试验次数，并在试验运行过程中实时更新结果直方图。加入理论概率对比、重置功能，以及动画速度控制。整体设计应适合教学，帮助用户直观理解基础概率概念。","build-mode-starters.example.math.vector-field.label":"矢量场","build-mode-starters.example.math.vector-field.prompt":"构建一个矢量场绘图工具，支持编辑矢量场方程、调节箭头密度，并可通过动画流线或粒子展示流动效果。加入预设、播放/暂停功能，以及悬停时显示矢量数值。数学界面应直观易用，并能提供即时的视觉反馈。","build-mode-starters.example.productivity.budget-planner.label":"预算规划员","build-mode-starters.example.productivity.budget-planner.prompt":"构建一个预算规划工具，包含收入和支出记录、分类明细、储蓄目标以及实时剩余余额。加入按类别展示支出的简洁图表，并支持编辑或删除交易记录。采用清晰的金融应用布局，让各项数字一目了然。","build-mode-starters.example.productivity.habit-tracker.label":"习惯追踪器","build-mode-starters.example.productivity.habit-tracker.prompt":"构建一个习惯追踪器，包含每日打卡、连续完成日历以及每项习惯的完成统计。支持添加、编辑和删除习惯、颜色标记，并将数据保存在本地存储中。让周视图或月视图清晰易读，并能激励用户坚持完成习惯。","build-mode-starters.example.productivity.kanban-board.label":"看板","build-mode-starters.example.productivity.kanban-board.prompt":"构建一个包含”待办”、”进行中”、”已完成”三列的看板，并支持拖动卡片。用户可以添加、编辑和删除带有标题及描述的卡片，每列还应显示卡片数量。将看板状态保存在本地存储中，并加入流畅的拖动动画。","build-mode-starters.example.productivity.notes-app.label":"笔记应用","build-mode-starters.example.productivity.notes-app.prompt":"构建一个笔记应用，包含侧边栏列表、主区域 Markdown 编辑、即时搜索以及创建和删除笔记功能。加入最后编辑时间、本地存储持久化，以及用于查看 Markdown 渲染效果的预览开关。提供适合键盘操作的导航，并采用简洁、专注的写作界面。","build-mode-starters.example.productivity.pomodoro-timer.label":"番茄钟","build-mode-starters.example.productivity.pomodoro-timer.prompt":"制作一个番茄钟，可自定义工作和休息时长，并支持开始、暂停和重置，同时提供当前时段的任务列表。加入时段计数、可选的完成提示音和可视化进度环。保持设计简洁沉静，并清晰展示当前状态。","build-mode-starters.example.simulation.boids-flock.label":"Boids 鸟群模拟","build-mode-starters.example.simulation.boids-flock.prompt":"创建一个鸟群模拟系统，让鸟群基于分离、对齐和聚合规则进行集群运动，并在鼠标指针靠近时四散逃离或主动避让。加入实时滑块，用于调节每项规则的权重、鸟群数量和移动速度。画布采用全屏无边界设计，控制面板清晰易读，实时动画流畅自然。","build-mode-starters.example.simulation.fluid-ripples.label":"流体涟漪","build-mode-starters.example.simulation.fluid-ripples.prompt":"构建一个交互式流体涟漪模拟器，可响应鼠标或触摸拖动，生成不断扩散并逐渐衰减的波纹。加入黏度、波浪强度和色彩图控制，以及清空水面的操作。效果应铺满全屏，并在连续交互时保持丝滑流畅。","build-mode-starters.example.simulation.game-of-life.label":"生命游戏","build-mode-starters.example.simulation.game-of-life.prompt":"构建康威生命游戏，提供可绘制的网格、播放和暂停、单步运行、速度控制，以及滑翔机和高斯帕滑翔机枪等图案预设。加入清除、随机生成和代数计数器功能。确保鼠标绘制流畅，并让网格在不同缩放级别下都保持清晰。","build-mode-starters.example.simulation.gravity-sim.label":"重力模拟","build-mode-starters.example.simulation.gravity-sim.prompt":"制作一个轨道重力模拟器，通过点击拖动抛出行星，观察它们运行、借助引力弹射并相互碰撞。加入质量预设、轨迹渲染、时间尺度控制和清除按钮。确保物理模拟足够稳定，让多天体运动呈现流畅而令人满意的效果。","build-mode-starters.example.simulation.physics-sandbox.label":"物理沙盒","build-mode-starters.example.simulation.physics-sandbox.prompt":"构建一个 3D 物理游乐场，用户可以放置球体、方块和圆柱体，让它们在重力作用下堆叠、弹跳和倾倒。提供生成形状、清空场景、调整重力和恢复系数以及拖动刚体的工具。使用简洁的工具栏和稳定的物理模拟，让交互即时响应。","build-mode-starters.example.three-d.3d-globe.label":"3D 地球仪","build-mode-starters.example.three-d.3d-globe.prompt":"构建一个可旋转的 3D 地球仪，包含发光地点标记，支持拖动旋转和点击聚焦到指定标记。加入精选地点列表、柔和的环境光，以及在用户交互时暂停的自动旋转功能。让场景铺满整个视口，营造细腻的氛围，并提供流畅的镜头过渡。","build-mode-starters.example.three-d.product-viewer.label":"产品查看器","build-mode-starters.example.three-d.product-viewer.prompt":"构建一个 3D 产品查看器，可环绕查看风格化的产品模型，并提供灯光控制、自动旋转以及材质或颜色选项。加入缩放、重置相机按钮，并在画布周围设计简洁的电商风格界面。确保桌面端和移动端的交互都流畅、精致且响应迅速。","build-mode-starters.example.three-d.solar-system.label":"太阳系","build-mode-starters.example.three-d.solar-system.prompt":"创建一个 3D 太阳系模拟器，展示围绕轨道运行的行星，并支持调节模拟速度、显示名称标签，以及点击行星后让镜头平滑聚焦。加入暂停控制、轨道轨迹，以及每颗行星的简要信息面板。整体采用深色、富有太空感的视觉风格，并保持动画循环平滑流畅。","build-mode-starters.example.three-d.starfield.label":"星空","build-mode-starters.example.three-d.starfield.prompt":"创建一个具有跃迁速度感的 3D 星空，用户可以使用鼠标或指针控制方向，并调整速度和星体密度。加入加速模式、细腻的运动模糊或星光拖影，以及不会遮挡视野的屏幕控件。营造沉浸式体验，并确保画面以 60fps 丝滑运行。","build-mode-starters.example.three-d.terrain-flyover.label":"地形飞越","build-mode-starters.example.three-d.terrain-flyover.prompt":"构建一个低多边形 3D 地形，用户可以通过鼠标控制视角并使用键盘推进飞行，同时提供线框显示开关和基于高度的着色。加入简单的地面碰撞检测、显示高度和速度的迷你 HUD，以及日间和夜间光照选项。保持艺术风格鲜明且画面清晰易辨。","build-mode-starters.example.tools.color-palette.label":"配色板","build-mode-starters.example.tools.color-palette.prompt":"构建一个包含五个色块的配色生成器，支持单独锁定颜色、随机更换配色，以及复制十六进制、RGB 和 HSL 数值。加入与文本颜色的对比度检查，并支持将配色导出为 CSS 变量。确保键盘快捷键和点击复制操作快速流畅。","build-mode-starters.example.tools.photo-booth.label":"照片亭","build-mode-starters.example.tools.photo-booth.prompt":"构建一个网页版摄像头拍照亭，支持实时预览、滤镜预设、拍摄前倒计时和照片下载。加入摄像头权限处理、近期照片画廊条，以及在设备支持时切换前后摄像头的功能。界面应活泼有趣、响应迅速，并清晰展示摄像头的当前状态。","build-mode-starters.example.tools.pixel-art.label":"像素艺术","build-mode-starters.example.tools.pixel-art.prompt":"构建一个像素画绘制工具，包含可调整大小的网格、调色板、画笔、橡皮擦、填充工具、撤销和重做以及 PNG 导出功能。加入网格显示开关、清空画布和具有复古风格的有限色板。通过指针事件确保绘制流畅，并采用简洁的工具栏。","build-mode-starters.example.tools.qr-generator.label":"二维码生成器","build-mode-starters.example.tools.qr-generator.prompt":"创建一个二维码生成器，用户输入网址或文本时可实时预览二维码，并提供前景色、背景色和尺寸调节功能。加入纠错等级选择和 PNG 下载功能。整体布局保持简洁，提供即时反馈，并为所有表单控件添加清晰、无障碍的标签。","build-mode-starters.example.website.bio-page.label":"个人简介页","build-mode-starters.example.website.bio-page.prompt":"创建一个个人链接聚合页面，包含圆形头像、显示名称、简短个人简介，以及纵向排列的精选链接按钮。加入社交媒体图标、细腻的悬停动画，以及浅色和深色主题切换功能。采用移动端优先设计，整体布局现代、精致，适合作为个人主页入口链接。","build-mode-starters.example.website.event-page.label":"活动页面","build-mode-starters.example.website.event-page.prompt":"构建一个单页活动网站，包含倒计时、日程安排、演讲嘉宾卡片、场地地图占位区域和 RSVP 表单。加入票务等级或名额提示、提交 RSVP 后的成功反馈，以及可固定显示并跳转至各部分的导航栏。采用响应式设计，并营造鲜明、有活力的活动品牌风格。","build-mode-starters.example.website.landing-page.label":"落地页","build-mode-starters.example.website.landing-page.prompt":"构建一个 SaaS 产品落地页，包含醒目的首屏区域、清晰的价值主张、功能网格、分级定价、用户评价和电子邮件注册表单。加入固定导航、平滑滚动锚点，并在页面各处设置有力的行动号召。采用完全响应式、简洁且以转化为导向的设计。","build-mode-starters.example.website.portfolio.label":"作品集","build-mode-starters.example.website.portfolio.prompt":"设计一个个人作品集网站，包含项目卡片、个人简介、技能展示和联系表单。项目卡片应提供悬停交互，悬停时显示简短描述，并支持通过分类标签筛选项目。加入精致完整的页脚。网站应采用响应式设计、平滑滚动效果，以及现代、富有编辑设计感的视觉风格。","build-mode-starters.more":"更多想法","button.make-video":"创作视频","chart.accuracy-warning":"Grok 可能会出错，请务必核查原始来源。","chart.download":"下载","chart.download.as-image":"下载为图片","chart.download.as-spreadsheet":"下载为表格","chart.failed-generation":"生成图表失败","chart.generating":"正在生成图表","chart.try-again":"重试","chat-column-toggle.collapse-label":"折叠工作区","chat-column-toggle.expand-label":"展开工作区","chat-column-toggle.expand-label-v2":"展开","chat-disclaimer":"Grok 可能会出错。请验证重要信息。","chat-not-found-error.cta":"开始新聊天","chat-not-found-error.description":"若此链接是他人提供，请确认对方是否正确发送了分享链接。","chat-n