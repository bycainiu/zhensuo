;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="0018c448-6609-4112-cfde-22a0abd29a5b")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,485794,(e,a,t)=>{a.exports=JSON.parse('{"Add to chat":"Add to chat","Anonymous":"Anonymous","Ask Grok":"Ask Grok","Ask anything":"Ask anything","Back":"Back","Cancel":"Cancel","Close":"Close","Close search":"Close search","Contact Support":"Contact Support","Content Moderated":"Content Moderated. Try a different idea.","Content is empty":"Content is empty","Continue":"Continue","Copied!":"Copied!","Copy":"Copy","Could not load document.":"Could not load document.","Create share link":"Create share link","Deep Search: Browsed URLs":"Deep Search: Browsed URLs","Documents":"Documents","Download":"Download","Download Asset":"Download Asset","Enter prompt here":"Enter prompt here","Explain":"Explain","Explain this":"Explain this","Failed to load image":"Failed to load image","Files":"Files","Generate more images like this":"Generate more images like this","Go to page":"Go to page","Good afternoon, {{username}}.":"Good afternoon, {{username}}.","Good evening, {{username}}.":"Good evening, {{username}}.","Good morning, {{username}}.":"Good morning, {{username}}.","Grok was unable to finish replying.description":"Please try again later or use a different model.","Grok was unable to finish replying.errorMessage":"Grok was unable to finish replying.","Grok was unable to reply.description":"Please try regenerating a response.","Grok was unable to reply.errorMessage":"Grok was unable to reply to your last message.","Hello":"Hello","Home page":"Home page","Loading Older Messages":"Loading Older Messages","Loading text…":"Loading text…","Mobile":"Mobile","Next result":"Next result","No content available.":"No content available.","No text content available.":"No text content available.","Open in New Tab":"Open in New Tab","Open in new tab":"Open in new tab","Original image to edit":"Original image to edit","Page":"Page","Page number":"Page number","Prefer this response":"Prefer this response","Previous result":"Previous result","Problem playing audio":"Problem playing audio","Quick Answer":"Quick Answer","Quote":"Quote","Rate Limit Reached.description":"Query limit reached for {{modelName}}. Limit refreshes in {{time}}.","Reconnecting...":"Reconnecting...","Refresh":"Refresh","Reload":"Reload","Remaining Queries.description_one":"One query left for {{modelName}}. Limit resets every {{time}}.","Remaining Queries.description_other":"You have {{count}} remaining queries for {{modelName}}. Limit resets every {{time}}.","Response letter":"Response {{letter}}","Retry":"Retry","Return to Home":"Return to Home","Save":"Save","Search":"Search","Search Results":"Search Results","Share conversation with team":"Share conversation with team","Skip Selection":"Skip Selection","Something went wrong when loading the document.":"Something went wrong when loading the document.","Source":"Source","Sources":"Sources","Switch to Default Chat":"Switch to Default Chat","Switch to Private Chat":"Switch to Private Chat","There was an error":"There was an error","Think Harder":"Think Harder","Thinking-content-override":"Thinking...","This will help make Grok better.":"This will help make Grok better.","Thoughts":"Thoughts","Try again or ":"Try again or ","Unauthenticated.description":"Please log in or refresh the page","Unauthenticated.errorMessage":"Unable to confirm user authenticity.","Update share link":"Update share link","Waiting-for-thinking":"Waiting for all responses to finish thinking","Welcome to Grok.":"Welcome to Grok.","Which response do you prefer?":"Which response do you prefer?","Wide":"Wide","Zoom in":"Zoom in","Zoom out":"Zoom out","anon-chat-not-found-error.cta":"Start a new chat","anon-chat-not-found-error.description":"Sign in to request access","anon-chat-not-found-error.sign-in":"Sign in","anon-chat-not-found-error.title":"This chat is private","app-grant.already-granted":"{{connector}} already granted","app-grant.already-granted-v2":"{{connector}} already granted — select to re-approve","app-grant.approve":"Allow {{connector}}","app-grant.approve-multi":"Allow {{count}} connectors","app-grant.approve-multi_one":"Allow {{count}} connectors","app-grant.approve-multi_other":"Allow {{count}} connectors","app-grant.body":"{{app}} is asking to use your {{connector}} connection so viewers who have connected {{connector}} can use those tools in the app. You can revoke this later.","app-grant.body-multi":"{{app}} is asking to use {{count}} of your connections so viewers who have connected them can use those tools in the app. You can revoke this later.","app-grant.body-multi_one":"{{app}} is asking to use {{count}} of your connections so viewers who have connected them can use those tools in the app. You can revoke this later.","app-grant.body-multi_other":"{{app}} is asking to use {{count}} of your connections so viewers who have connected them can use those tools in the app. You can revoke this later.","app-grant.deny":"Not now","app-grant.error":"Couldn\'t grant access. Try again.","app-grant.granted-pill":"{{connector}} ✓","app-grant.pick-connector":"Choose a connection","app-grant.success":"Access granted. Your app can use {{connector}}.","app-grant.this-app":"This app","app-grant.title":"Allow connector access?","ask-user-question.answer":"Answer","ask-user-question.answers":"Answers","ask-user-question.custom-answer":"Custom answer","ask-user-question.dismiss":"Dismiss question","ask-user-question.done":"Done","ask-user-question.next":"Next","ask-user-question.no-answer":"(No answer provided)","ask-user-question.previous":"Previous question","ask-user-question.question":"Question","ask-user-question.questions":"Questions","ask-user-question.step":"{{current}} of {{total}}","asset-viewer.expand-image":"View image fullscreen","asset-viewer.expand-video":"View video fullscreen","asset-viewer.video":"Video","asset-viewer.video-load-error":"This video could not be played.","audio-player.mute-button.label":"Mute","audio-player.pause-button.label":"Pause","audio-player.play-button.label":"Play","audio-player.seek-slider.label":"Seek","audio-player.unmute-button.label":"Unmute","autocomplete_suggestion_copy.label":"Copy to clipboard","autocomplete_suggestion_copy.toast":"Copied to clipboard","background-tasks-tray.delete-failed.toast":"Could not delete the scheduled task","background-tasks-tray.delete-scheduled-button.label":"Delete scheduled task","background-tasks-tray.kill-button.label":"Stop task","background-tasks-tray.kill-failed.toast":"Could not stop the task","background-tasks-tray.next-fire-soon.label":"soon","background-tasks-tray.title":"Background tasks","background-tasks-tray.toggle-button.label":"Toggle background tasks","build-mode-hint.cta":"Switch","build-mode-hint.dismiss":"Dismiss","build-mode-hint.subtitle":"Build Mode can turn this into a website, game, app, or dashboard.","build-mode-hint.subtitle-short":"Turn this into a website, game, or app.","build-mode-hint.title":"Switch to Build Mode","build-mode-hint.title-short":"Build Mode","build-mode-starters.example.audio.audio-visualizer.label":"Audio visualizer","build-mode-starters.example.audio.audio-visualizer.prompt":"Build a music visualizer that reacts to microphone input or an uploaded track with animated bars, circular modes, and color themes. Include play/pause for files, sensitivity control, and fullscreen. Make the visualization smooth and the controls unobtrusive.","build-mode-starters.example.audio.chord-player.label":"Chord player","build-mode-starters.example.audio.chord-player.prompt":"Build a chord-progression player with a scale or key picker, common progression presets, strum or arpeggio patterns, and looping playback. Include tempo control, highlighted active chord, and the ability to edit the progression sequence. Make it useful for songwriting practice with a clean music-app UI.","build-mode-starters.example.audio.drum-machine.label":"Drum machine","build-mode-starters.example.audio.drum-machine.prompt":"Build a step-sequencer drum machine with a 16-step grid for kick, snare, hats, and percussion, plus tempo control and play/stop. Include pattern clear, randomize, swing, and visual step highlighting as it plays. Make the UI grid-based, responsive, and satisfying to click.","build-mode-starters.example.audio.synth-keyboard.label":"Synth keyboard","build-mode-starters.example.audio.synth-keyboard.prompt":"Create a playable synth keyboard with on-screen keys, computer keyboard mapping, waveform selection, and filter and envelope knobs. Include octave shift, volume, and a simple oscilloscope or level meter. Make pressed keys light up and audio start only after a user gesture.","build-mode-starters.example.audio.theremin.label":"Theremin","build-mode-starters.example.audio.theremin.prompt":"Build a mouse-controlled theremin with pitch mapped to X and volume to Y, plus waveform choice and reverb. Include a visual guide for the play area, mute toggle, and a simple pitch readout. Make the sound expressive and the interaction immediately understandable.","build-mode-starters.example.data-viz.network-graph.label":"Network graph","build-mode-starters.example.data-viz.network-graph.prompt":"Build a force-directed network graph with draggable nodes, zoom and pan, edge labels, and a search box that highlights matching nodes. Include sample graph data, click-to-inspect node details, and controls to reheat or freeze the simulation. Make the canvas full-bleed and performance-friendly.","build-mode-starters.example.data-viz.poll-app.label":"Poll app","build-mode-starters.example.data-viz.poll-app.prompt":"Build a live poll app where users can create a question with multiple options, vote once, and see animated result bars update in real time with local state. Include a total-votes counter, percentage labels, and the ability to reset or start a new poll. Make it responsive with clear selected and disabled states.","build-mode-starters.example.data-viz.revenue-dashboard.label":"Revenue dashboard","build-mode-starters.example.data-viz.revenue-dashboard.prompt":"Build an interactive revenue dashboard with date range filters, KPI cards for revenue, growth, and churn, and trend charts that update with the selection. Include a breakdown table, hover tooltips, and sample data so it works offline. Make the layout responsive with a clean analytics aesthetic.","build-mode-starters.example.data-viz.world-map.label":"World map","build-mode-starters.example.data-viz.world-map.prompt":"Create a choropleth world map that colors countries by a metric, with a legend, hover tooltips, and a metric switcher. Include sample data, pan and zoom, and a side panel that shows details for the selected country. Make interactions smooth and the visual hierarchy clear.","build-mode-starters.example.game.3d-maze.label":"3D maze","build-mode-starters.example.game.3d-maze.prompt":"Create a first-person low-poly 3D maze with WASD movement, mouse look, and collectibles scattered through the corridors. Include a minimap that reveals explored paths, a timer, and a win screen when the exit is found. Make collision with walls feel solid and keep the aesthetic clean and playful.","build-mode-starters.example.game.endless-runner.label":"Endless runner","build-mode-starters.example.game.endless-runner.prompt":"Build a browser endless runner where the player jumps and slides past procedural obstacles that get denser over time. Include one-tap or spacebar jump, combo scoring, speed ramps, and a high-score that persists in local storage. Add a game-over screen with restart and smooth animations for jump, land, and obstacle collisions.","build-mode-starters.example.game.platformer.label":"Platformer","build-mode-starters.example.game.platformer.prompt":"Create a 2D platformer with run, jump, double-jump, moving platforms, coins, and hazards. Include a checkpoint system, a coin counter, and a goal flag that ends the level. Make controls responsive with arrow keys or WASD, and add a simple level select or restart on death.","build-mode-starters.example.game.space-shooter.label":"Space shooter","build-mode-starters.example.game.space-shooter.prompt":"Make a top-down space shooter with enemy waves, player shooting, and power-ups for multi-shot, shield, and speed. Include lives, score tracking, a high-score board, and a pause menu. Add parallax starfield background, muzzle flashes, and smooth ship movement with keyboard or pointer controls.","build-mode-starters.example.game.tower-defense.label":"Tower defense","build-mode-starters.example.game.tower-defense.prompt":"Build a tower-defense game with a path for creeps, placeable towers, and gold earned from kills. Include multiple tower types with different ranges and costs, wave progression, and an upgrade path for damage and fire rate. Show lives remaining, current gold, and a game-over or victory screen with restart.","build-mode-starters.example.generative.flow-field.label":"Flow field","build-mode-starters.example.generative.flow-field.prompt":"Create a flow-field art generator with drifting particles that follow a noise field, plus controls for speed, trail length, and palette. Include a randomize seed button, pause, and PNG export. Make the full canvas generative and satisfying to watch evolve.","build-mode-starters.example.generative.fractal-tree.label":"Fractal tree","build-mode-starters.example.generative.fractal-tree.prompt":"Create a generative fractal tree that grows with adjustable branching angle, depth, and length, plus a gentle wind sway. Include a regenerate button, color palette controls, and optional leaf or blossom overlays. Animate growth on load so the tree feels alive.","build-mode-starters.example.generative.kaleidoscope.label":"Kaleidoscope","build-mode-starters.example.generative.kaleidoscope.prompt":"Make a kaleidoscope that mirrors pointer movement into symmetric, colorful patterns with adjustable segment count and color modes. Include a freeze frame option, randomize, and export image. Keep animations fluid and the controls simple enough to play with immediately.","build-mode-starters.example.generative.mandelbrot-zoom.label":"Mandelbrot zoom","build-mode-starters.example.generative.mandelbrot-zoom.prompt":"Build a Mandelbrot fractal explorer with click-to-zoom, drag to pan, smooth coloring, and iteration controls. Include preset interesting locations, a reset view button, and performance-conscious rendering. Make the UI minimal so the fractal stays the focus.","build-mode-starters.example.generative.particle-field.label":"Particle field","build-mode-starters.example.generative.particle-field.prompt":"Build an interactive particle field that swirls toward the cursor with trails, color shifts, and adjustable particle count and force. Include a clear/reset control, background color options, and a download screenshot button. Make pointer interactions feel immediate and visually rich.","build-mode-starters.example.math.fourier-drawing.label":"Fourier drawing","build-mode-starters.example.math.fourier-drawing.prompt":"Build a Fourier-series toy that redraws a drawn or preset shape with spinning epicycles, adjustable term count, and playback speed. Include draw-your-own mode, play/pause, and a trail of the reconstructed path. Make the epicycles visually clear and the controls simple.","build-mode-starters.example.math.function-grapher.label":"Function grapher","build-mode-starters.example.math.function-grapher.prompt":"Build an interactive function grapher that plots one or more equations with zoom, pan, grid, and a value readout under the cursor. Include example functions, axis labels, and error handling for invalid input. Make the graphing area large and the controls secondary but clear.","build-mode-starters.example.math.prime-explorer.label":"Prime explorer","build-mode-starters.example.math.prime-explorer.prompt":"Build a visual prime-number explorer with an animated sieve of Eratosthenes, clickable integers, and factor breakdowns for composite numbers. Include range controls, play/pause for the animation, and a list of primes found. Make the visualization educational and easy to follow.","build-mode-starters.example.math.probability-lab.label":"Probability lab","build-mode-starters.example.math.probability-lab.prompt":"Create a probability simulator with dice and coin modes, configurable trial counts, and a live histogram of outcomes that updates as trials run. Include theoretical probability comparison, reset, and speed control for animations. Make it useful for teaching basic probability intuition.","build-mode-starters.example.math.vector-field.label":"Vector field","build-mode-starters.example.math.vector-field.prompt":"Build a vector-field plotter with an editable equation for the field, arrow density controls, and animated flow lines or particles. Include presets, play/pause, and hover readout of vector values. Keep the math UI approachable with immediate visual feedback.","build-mode-starters.example.productivity.budget-planner.label":"Budget planner","build-mode-starters.example.productivity.budget-planner.prompt":"Build a budget planner with income and expense entries, category breakdowns, a savings goal, and a live remaining balance. Include a simple chart of spending by category and the ability to edit or delete transactions. Make numbers easy to scan with a clean finance-app layout.","build-mode-starters.example.productivity.habit-tracker.label":"Habit tracker","build-mode-starters.example.productivity.habit-tracker.prompt":"Build a habit tracker with daily check-offs, a streak calendar, and completion stats for each habit. Include add/edit/delete habits, color coding, and persistence in local storage. Make the weekly or monthly view scannable and motivating.","build-mode-starters.example.productivity.kanban-board.label":"Kanban board","build-mode-starters.example.productivity.kanban-board.prompt":"Build a kanban board with To Do, Doing, and Done columns and draggable cards. Include the ability to add, edit, and delete cards with titles and descriptions, plus card counts per column. Persist board state in local storage and add smooth drag animations.","build-mode-starters.example.productivity.notes-app.label":"Notes app","build-mode-starters.example.productivity.notes-app.prompt":"Build a notes app with a sidebar list, markdown editing in the main pane, instant search, and create/delete notes. Include last-edited timestamps, local storage persistence, and a preview toggle for rendered markdown. Make keyboard-friendly navigation and a minimal, focused writing UI.","build-mode-starters.example.productivity.pomodoro-timer.label":"Pomodoro timer","build-mode-starters.example.productivity.pomodoro-timer.prompt":"Make a Pomodoro timer with configurable work and break lengths, start/pause/reset, and a task list for the current session. Include session counts, optional sound on complete, and a visual progress ring. Keep the design focused and calm with clear active states.","build-mode-starters.example.simulation.boids-flock.label":"Boids flock","build-mode-starters.example.simulation.boids-flock.prompt":"Create a flocking simulation of boids that swarm with separation, alignment, and cohesion, and scatter or avoid the cursor. Include live sliders for each rule weight, population size, and speed. Make the canvas full-bleed with readable controls and smooth real-time motion.","build-mode-starters.example.simulation.fluid-ripples.label":"Fluid ripples","build-mode-starters.example.simulation.fluid-ripples.prompt":"Build an interactive fluid-ripple simulation that reacts to mouse or touch drags with expanding waves and damping. Include controls for viscosity, wave strength, and color map, plus a clear surface action. Make the effect full-screen and silky on continuous interaction.","build-mode-starters.example.simulation.game-of-life.label":"Game of Life","build-mode-starters.example.simulation.game-of-life.prompt":"Build Conway\'s Game of Life with a paintable grid, play/pause, step, speed control, and pattern presets like glider and gosper gun. Include clear, randomize, and generation counter. Make painting with the mouse fluid and the grid crisp at multiple zoom levels.","build-mode-starters.example.simulation.gravity-sim.label":"Gravity sim","build-mode-starters.example.simulation.gravity-sim.prompt":"Make an orbital gravity simulator where you click-drag to fling planets and watch them orbit, slingshot, and collide. Include mass presets, trail rendering, time scale control, and a clear button. Keep the physics stable enough for satisfying multi-body choreography.","build-mode-starters.example.simulation.physics-sandbox.label":"Physics sandbox","build-mode-starters.example.simulation.physics-sandbox.prompt":"Build a 3D physics playground where you can drop spheres, boxes, and cylinders that stack, bounce, and topple under gravity. Include tools to spawn shapes, clear the world, adjust gravity and restitution, and drag bodies around. Make interactions immediate with a simple toolbar and stable simulation.","build-mode-starters.example.three-d.3d-globe.label":"3D globe","build-mode-starters.example.three-d.3d-globe.prompt":"Build a rotating 3D globe with glowing location markers, drag-to-spin, and click-to-focus on a marker. Include a list of featured locations, soft ambient lighting, and auto-rotate that pauses while the user interacts. Make the scene full-viewport with a subtle atmosphere and smooth camera transitions.","build-mode-starters.example.three-d.product-viewer.label":"Product viewer","build-mode-starters.example.three-d.product-viewer.prompt":"Build a 3D product viewer that orbits a stylized product model with lighting controls, auto-rotate, and material or color variants. Include zoom, a reset camera button, and a clean commerce-style UI chrome around the canvas. Make interactions feel premium and responsive on desktop and mobile.","build-mode-starters.example.three-d.solar-system.label":"Solar system","build-mode-starters.example.three-d.solar-system.prompt":"Create a 3D solar system with orbiting planets, adjustable simulation speed, labels, and click-to-focus camera moves. Include a pause control, orbital trails, and simple info panels for each planet. Keep the aesthetic dark and spacey with smooth animation loops.","build-mode-starters.example.three-d.starfield.label":"Starfield","build-mode-starters.example.three-d.starfield.prompt":"Create a warp-speed 3D starfield you can steer with the mouse or pointer, with adjustable speed and density. Include a boost mode, subtle motion blur or streaking stars, and on-screen controls that do not clutter the view. Make it immersive and buttery smooth at 60fps.","build-mode-starters.example.three-d.terrain-flyover.label":"Terrain flyover","build-mode-starters.example.three-d.terrain-flyover.prompt":"Build a low-poly 3D terrain you can fly over with mouse-look and keyboard thrust, plus a wireframe toggle and height-based coloring. Include simple collision with the ground, a mini HUD for altitude and speed, and day/night lighting options. Keep the art style stylized and readable.","build-mode-starters.example.tools.color-palette.label":"Color palette","build-mode-starters.example.tools.color-palette.prompt":"Build a color-palette generator with five swatches, lock per color, shuffle, and copyable hex, RGB, and HSL values. Include contrast checks against text colors and export of the palette as CSS variables. Make keyboard shortcuts and click-to-copy feel snappy.","build-mode-starters.example.tools.photo-booth.label":"Photo booth","build-mode-starters.example.tools.photo-booth.prompt":"Build a webcam photo booth with live preview, filter presets, a countdown before capture, and snapshot download. Include permission handling, a gallery strip of recent shots, and flip camera when available. Make the UI playful and responsive with clear camera states.","build-mode-starters.example.tools.pixel-art.label":"Pixel art","build-mode-starters.example.tools.pixel-art.prompt":"Build a pixel-art drawing tool with a resizable grid, color palette, pencil and eraser, fill tool, undo/redo, and PNG export. Include grid toggle, clear canvas, and a limited palette for a retro feel. Make drawing smooth with pointer events and a clean toolbar.","build-mode-starters.example.tools.qr-generator.label":"QR generator","build-mode-starters.example.tools.qr-generator.prompt":"Create a QR-code generator with a live preview as you type a URL or text, color options for foreground and background, and size control. Include error correction level selection and PNG download. Keep the layout simple with instant feedback and accessible form labels.","build-mode-starters.example.website.bio-page.label":"Bio page","build-mode-starters.example.website.bio-page.prompt":"Create a link-in-bio page with a circular avatar, display name, short bio, and a vertical stack of featured link buttons. Include social icons, subtle hover animations, and a theme toggle between light and dark. Make it mobile-first with a polished, modern layout that works well as a personal landing link.","build-mode-starters.example.website.event-page.label":"Event page","build-mode-starters.example.website.event-page.prompt":"Build a one-page event site with a countdown timer, schedule agenda, speaker cards, venue map placeholder, and an RSVP form. Include ticket tiers or capacity messaging, success feedback after RSVP, and sticky nav for each section. Make it responsive with a vibrant, event-branded aesthetic.","build-mode-starters.example.website.landing-page.label":"Landing page","build-mode-starters.example.website.landing-page.prompt":"Build a SaaS product landing page with a bold hero, clear value proposition, feature grid, pricing tiers, testimonials, and an email signup form. Include sticky navigation, smooth scroll anchors, and a strong call-to-action throughout. Make it fully responsive with a clean, conversion-oriented design.","build-mode-starters.example.website.portfolio.label":"Portfolio","build-mode-starters.example.website.portfolio.prompt":"Design a personal portfolio site with project cards, an about section, skills, and a contact form. Include hover states on projects that reveal short descriptions, filter chips by category, and a polished footer. Make it responsive with smooth scroll and a modern, editorial visual style.","build-mode-starters.more":"More ideas","button.make-video":"Make video","canvas-files.upload-progress_one":"Uploading <num>{{progress}}</num> items","canvas-files.upload-progress_other":"Uploading <num>{{progress}}</num> items","chart.accuracy-warning":"Grok can make mistakes. Always check original sources.","chart.download":"Download","chart.download.as-image":"As Image","chart.download.as-spreadsheet":"As Spreadsheet","chart.failed-generation":"Failed to generate chart","chart.generating":"Generating chart","chart.try-again":"Try Again","chat-column-toggle.collapse-label":"Collapse workspace","chat-column-toggle.expand-label":"Expand workspace","chat-column-toggle.expand-label-v2":"Expand","chat-disclaimer":"Grok can make mistakes. Verify important information.","chat-not-found-error.cta":"Start a new chat","chat-not-found-error.description":"If this was a link someone shared with you, please ask the sender to explicitly send a share link.","chat-not-found-error.title":"Chat not found","chat-survey-standard-title":"Are you satisfied with Grok\'s answer?","chat-survey.close":"Close","chat-survey.send-feedback":"Send Feedback","chat-survey.success.description":"It helps us make Grok even better for you","chat-survey.success.title":"Thanks for your feedback","chat-survey.thumbs_down":"Dislike","chat-survey.thumbs_up":"Like","chat-top-nav.view-count-tooltip":"Shared conversation views","citation.executed-code":"Executed code","citation.sources-pill-code-exec-label":"View code executions","citation.sources-pill-sources_one":"{{count}} source","citation.sources-pill-sources_other":"{{count}} sources","clickwrapAgreement":"By messaging Grok, you agree to our <terms>Terms</terms> and <policy>Privacy Policy</policy>.","connector-keyword-upsell.cta":"Connect","connector-keyword-upsell.dismiss":"Dismiss","connector-keyword-upsell.subtitle.box":"Grok can search for files and read your documents.","connector-keyword-upsell.subtitle.canva":"Grok can create, edit, and manage your designs.","connector-keyword-upsell.subtitle.default":"Grok can search, read, and take actions on your behalf.","connector-keyword-upsell.subtitle.figma":"Grok can search, read, and edit your designs.","connector-keyword-upsell.subtitle.github":"Grok can search repos, read code, and manage issues and pull requests.","connector-keyword-upsell.subtitle.gmail":"Grok can search, read, and draft emails for you.","connector-keyword-upsell.subtitle.google-calendar":"Grok can view, create, and manage your calendar events.","connector-keyword-upsell.subtitle.google-drive":"Grok can search for documents and read and write files for you.","connector-keyword-upsell.subtitle.linear":"Grok can search, create, and manage your issues and projects.","connector-keyword-upsell.subtitle.notion":"Grok can search, read, and edit your pages.","connector-keyword-upsell.subtitle.outlook":"Grok can search, read, and draft emails for you.","connector-keyword-upsell.subtitle.slack":"Grok can search, read, and send messages in your channels.","connector-keyword-upsell.title":"Connect {{name}} to Grok","connectors-upsell.connectors-subtitle":"Connectors allow Grok to interact with apps directly in conversations.","connectors-upsell.connectors-title":"Connectors are now available.","connectors-upsell.cta":"Connect","connectors-upsell.dismiss":"Dismiss","continued-conversation-title":"Continued: {{title}}","conversation-load-failed-error.cta":"Retry","conversation-load-failed-error.description":"Something went wrong while loading this chat. Check your connection and try again."